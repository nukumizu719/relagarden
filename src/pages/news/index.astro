---
/**
 * news/index.astro
 * microCMSのデータを統合し、ニュース一覧の1ページ目を表示します。
 */
import { getCases, getNews } from '../../lib/microcms';
import PageContent from './[page].astro';

// 1. microCMSからデータを並列取得（最新分を多めに取得）
const [casesResponse, newsResponse] = await Promise.all([
  getCases({ limit: 100, orders: '-pubDate' }),
  getNews({ limit: 100, orders: '-pubDate' })
]);

// 2. 施工事例をニュース形式に変換
const caseAsNews = casesResponse.contents.map((c) => ({
  date: new Date(c.pubDate || c.publishedAt),
  title: `【施工事例】${c.area}：${c.title}`,
  url: `/cases/${c.id}/`,
  category: '施工事例',
}));

// 3. 手動ニュースを統合用に変換
const manualNews = newsResponse.contents.map((n) => ({
  date: new Date(n.pubDate || n.publishedAt),
  title: n.title,
  url: `/news/${n.id}/`,
  category: n.category?.[0] || 'お知らせ',
}));

// 4. 全データを合体させて日付順（降順）にソート
const sortedNews = [...caseAsNews, ...manualNews].sort(
  (a, b) => b.date.getTime() - a.date.getTime()
);

// 5. [page].astro に渡すための擬似ページネーションオブジェクトを作成
const pageSize = 9;
const totalCount = sortedNews.length;
const lastPage = Math.ceil(totalCount / pageSize);

const page = {
  data: sortedNews.slice(0, pageSize),
  url: {
    prev: undefined,
    next: totalCount > pageSize ? "/news/2/" : undefined,
  },
  currentPage: 1,
  lastPage: lastPage,
};
---

<PageContent page={page} />