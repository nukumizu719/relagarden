---
import { client, type Case } from '../../lib/microcms';
import PageContent from './[page].astro';

// 1. microCMSから全事例を取得（日付順）
const response = await client.get({ 
  endpoint: 'cases',
  queries: { 
    orders: '-pubDate', // 手動設定の日付の降順
    limit: 100 
  }
});

const allCases: Case[] = response.contents;

// 2. 1ページ目のデータを擬似的に作成（ページネーション用）
const pageSize = 9;
const page = {
  data: allCases.slice(0, pageSize),
  url: {
    prev: undefined,
    next: allCases.length > pageSize ? "/cases/2/" : undefined,
  },
  currentPage: 1,
  lastPage: Math.ceil(allCases.length / pageSize),
};
---

<PageContent page={page} />